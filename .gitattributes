# Normalize line endings for text files
* text=auto

# Force LF for shell scripts
*.sh text eol=lf

# Force LF for Python files
*.py text eol=lf

# Force LF for YAML and config files
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf

# Force LF for Markdown
*.md text eol=lf

# Treat binary files as binary (no line ending conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.pth binary
*.pt binary
*.pkl binary
*.npy binary
*.npz binary
